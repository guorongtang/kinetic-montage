{
  "name": "kinetic-montage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic fast-cut kinetic typography video generator (v13 style)",
  "bin": { "kinetic": "./bin/kinetic.mjs" },
  "scripts": {
    "doctor": "node bin/kinetic.mjs doctor",
    "test": "node tools/test-fidelity.mjs",
    "regress": "node tools/regress.mjs",
    "build:v13": "node bin/kinetic.mjs build examples/v13-regression --name v13-rebuild"
  },
  "dependencies": {
    "playwright": "1.64.1"
  },
  "engines": { "node": ">=20" }
}
